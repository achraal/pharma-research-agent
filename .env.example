# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure your credentials:
#   cp .env.example .env
# ==============================================================================

# LLM & Embedding API Key (OpenAI key or LiteLLM proxy key)
OPENAI_API_KEY=your_api_key_or_litellm_proxy_key

# Base URL for the OpenAI-compatible endpoint (optional if using direct OpenAI)
# Example for LiteLLM proxy: https://your-litellm-proxy-url/v1
OPENAI_BASE_URL=https://your-litellm-proxy-url/v1

# Chat completion model name
OPENAI_MODEL=gpt-4o-mini

# Embedding model name
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

